{
  "expo": {
    "name": "Rescore: Food Hygiene Rating",
    "slug": "rescore",
    "scheme": "rescore",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F6F5",
    "primaryColor": "#0F7B4B",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "app.rescore.ios",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Rescore uses the camera to photograph your inspection report and each fix you make, so the evidence carries a date.",
        "NSPhotoLibraryUsageDescription": "Rescore attaches photos you already have as evidence against an item on your action plan.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.rescore.android",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F4F6F5"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Rescore uses the camera to photograph your inspection report and each fix you make, so the evidence carries a date."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://rescore-nodd.netlify.app",
      "eas": {
        "projectId": "143050b3-b8f6-46a2-a93f-f746d8c14ecf"
      },
      "router": {}
    },
    "owner": "7amdev"
  }
}
