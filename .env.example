# Rescore web. Copy to .env.local and fill in. Never commit a filled-in copy.

# The report reader and the rest of the model calls.
#
# Use RESCORE_ANTHROPIC_API_KEY, not ANTHROPIC_API_KEY: Netlify injects an
# ANTHROPIC_API_KEY of its own for its AI features, and it shadows yours, which
# shows up as a 401 from the reader.
RESCORE_ANTHROPIC_API_KEY=
ANTHROPIC_CLASSIFY_MODEL=claude-sonnet-5

# The site's own URL, used by the sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://rescore.app

# Stripe Managed Payments, one price per product (spec 4.3 and 6).
# Stripe is the merchant of record and handles VAT. Lemon Squeezy is not used.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_R01=
STRIPE_PRICE_R2=
STRIPE_PRICE_R34=
STRIPE_PRICE_PREMISES=

# Supabase, London region. Cases, items, evidence, leads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Case links by email.
RESEND_API_KEY=

# The FSA watcher posts new low ratings here (spec 4.6).
SLACK_LEADS_WEBHOOK=

# Postal outreach (spec 8.3).
STANNP_API_KEY=

# The environmental health consultant the hard stops refer to (spec 3.7).
EHC_REFERRAL_URL=

# Rate limiting for the free report reader.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics and errors.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
