{
  "name": "rescore-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Rescore: food hygiene re-rating pack builder for UK food businesses rated 0, 1 or 2.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed:councils": "npm run seed --workspace @rescore/content",
    "watch:fsa": "npm run watch --workspace @rescore/fsa"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
